# App
APP_ENV=development
APP_SECRET_KEY=change-me

# Supabase — required. Project URL and keys from Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq — required. Create a key at console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Apify — required. console.apify.com → Settings → API & Integrations
APIFY_API_TOKEN=your-apify-token

# Slack — optional. Leave blank to skip briefing delivery.
SLACK_WEBHOOK_URL=

# n8n — optional, for scheduled workflows.
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

RATE_LIMIT_PER_MINUTE=60
